import {loadPyodide} from "https://cdn.jsdelivr.net/pyodide/v{{ pyodide_version }}/full/pyodide.mjs"
import {offMeshToBinaryStl} from "./{{ static_dir }}/editor/off.js"
import {meshToGlb} from "./{{ static_dir }}/editor/glb.js"
import {prepareRuntimeFile} from "./{{ static_dir }}/editor/runtimeFiles.js"
import {formatErrorForMessage, getLog, logError, logInfo, resetLog} from "./{{ static_dir }}/editor/workerLog.js"

console.log("CadQuery worker started")

// Model files are written below this directory in the Python file system, so
// they can't collide with Pyodide's own directories (e.g. /lib).
const MODEL_ROOT = "/model"
// Pyodide packages loaded during startup, and ones loaded only when a model needs them
const PYODIDE_PACKAGES = {{ pyodide_packages | json_dump }}
const DEFERRED_PACKAGES = {{ deferred_packages | json_dump }}
// Bundled modules that are imported on first use
const DEFERRED_INSTALLED_MODULES = {{ deferred_installed_modules | json_dump }}
// OCP.wasm (OpenCascade), and the precompiled pure-Python packages
const OCP_URL = new URL({{ ocp_url | json_dump }}, self.location.href).href
const SITE_PACKAGES_URL = new URL({{ site_packages_url | json_dump }}, self.location.href).href
// Packages that are only downloaded when a model imports them (e.g. ezdxf)
const ON_DEMAND_URL = {% if on_demand_url %}new URL({{ on_demand_url | json_dump }}, self.location.href).href{% else %}null{% endif %}
const ON_DEMAND_DOWNLOAD = {{ on_demand_download | json_dump }}
const ON_DEMAND_MODULES = {{ on_demand_modules | json_dump }}
// Fonts for text(), downloaded when a model first looks up a font
const FONTS_URL = {% if fonts_url %}new URL({{ fonts_url | json_dump }}, self.location.href).href{% else %}null{% endif %}
const FONTS_DOWNLOAD = {{ fonts_download | json_dump }}
const TOLERANCE = {{ config.cadquery.tolerance | json_dump }}
const ANGULAR_TOLERANCE = {{ config.cadquery.angular_tolerance | json_dump }}
// Used for parts without a color when other parts have one (OpenSCAD's default).
const DEFAULT_PART_COLOR = [0.976, 0.843, 0.173]

const INPUT_FILES = new Map()
{% for virtual_path, digest in fs_manifest.items() %}
INPUT_FILES.set({{ virtual_path | json_dump }}, `./{{ fs_cas_dir }}/{{ digest }}`)
{% endfor %}

let runQueue = Promise.resolve()
let runtimePromise = null
let runtimeReady = false
// Deferred Pyodide packages and on-demand downloads that were loaded
const loadedOnDemand = new Set()

// Steps of the first render, for the progress bar: the fraction of the bar
// where each starts and its typical duration in seconds. The durations are
// rough (import OCP takes about 5 s in Chrome, 1 s in Firefox); the bar eases
// towards the next step's start and jumps ahead when the step is done early.
const FIRST_RENDER_STEPS = {
    pyodide: { start: 0, seconds: 3 },
    ocp: { start: 0.3, seconds: 0.3 },
    ocpInit: { start: 0.35, seconds: 4 },
    cadquery: { start: 0.8, seconds: 1.2 },
    render: { start: 0.92, seconds: 1 },
}
let firstRenderDone = false

/**
 * Report progress. With a step of FIRST_RENDER_STEPS (only during the first
 * render), the page shows a progress bar.
 */
function progress(message, step = null) {
    logInfo(message)
    let bar = null
    if (step && !firstRenderDone) {
        const names = Object.keys(FIRST_RENDER_STEPS)
        const next = FIRST_RENDER_STEPS[names[names.indexOf(step) + 1]]
        bar = { from: FIRST_RENDER_STEPS[step].start, to: next ? next.start : 1, seconds: FIRST_RENDER_STEPS[step].seconds }
    }
    self.postMessage({ type: "progress", message, bar })
}

async function fetchBytes(url) {
    const r = await fetch(url)
    if (!r.ok) {
        throw new Error(`Failed to fetch ${url}: ${r.status} ${r.statusText}`)
    }
    return new Uint8Array(await r.arrayBuffer())
}

function writeFile(pyodide, path, data) {
    const parent = path.substring(0, path.lastIndexOf("/"))
    if (parent) {
        pyodide.FS.mkdirTree(parent)
    }
    pyodide.FS.writeFile(path, data)
}

/** Run a load step and log how long it took. */
async function timed(label, fn) {
    const start = performance.now()
    const result = await fn()
    logInfo(`[load] ${label}: ${((performance.now() - start) / 1000).toFixed(2)}s`)
    return result
}

const helperResults = new Map()

/**
 * Download and unpack a runtime file (OCP compiled to a WebAssembly.Module, or
 * a site-packages bundle) in a helper worker, so that it runs in parallel with
 * Pyodide's startup instead of competing with it on this thread.
 *
 * The page starts the helper (see rendering.js) and forwards the result,
 * which avoids relying on nested workers. If that fails, do it here.
 */
async function prepareInHelper(task, url) {
    try {
        return await new Promise((resolve, reject) => {
            helperResults.set(task, { resolve, reject })
            self.postMessage({
                type: "prepare-runtime-file",
                helperUrl: new URL("./{{ static_dir }}/editor/runtimeFilesWorker.js", self.location.href).href,
                task,
                url,
            })
        })
    } catch (e) {
        logInfo(`Helper for ${task} failed, preparing it in this worker:`, e)
        return await prepareRuntimeFile(task, url)
    }
}

/**
 * Load a shared library that was already compiled to a WebAssembly.Module.
 *
 * This uses Emscripten's dynamic linker (exposed by Pyodide) to instantiate
 * the module, then registers it as preloaded, so that Pyodide's loader (and
 * `import OCP`) use it instead of reading and compiling the file. The file
 * itself only needs to exist.
 */
async function linkPrecompiled(pyodide, path, module) {
    const emscripten = pyodide._module
    const key = emscripten.PATH.normalize(path)
    writeFile(pyodide, path, new Uint8Array(1))
    const exports = await emscripten.loadWebAssemblyModule(
        module,
        { loadAsync: true, nodelete: true, global: true },
        key,
        {},
    )
    emscripten.preloadedWasm[key] = exports
    await pyodide._api.loadDynlib(path, true)
}

async function initRuntime() {
    const start = performance.now()
    progress("Loading Python runtime…", "pyodide")
    // Downloads and unpacking run in parallel with Pyodide's startup.
    const ocpPromise = timed("download, decompress and compile OCP (helper)", () => prepareInHelper("ocp", OCP_URL))
    const sitePromise = timed("download and unpack site-packages (helper)", () => prepareInHelper("site-packages", SITE_PACKAGES_URL))
    const inputFilesPromise = Promise.all(
        Array.from(INPUT_FILES.entries()).map(async ([path, url]) => [path, await fetchBytes(url)]),
    )
    // Pyodide's own packages are loaded before OCP: loading other native
    // libraries after OCP's large one is much slower.
    const pyodide = await timed("Pyodide and packages", () => loadPyodide({
        packages: PYODIDE_PACKAGES,
        stdout: logInfo,
        stderr: logInfo,
    }))
    const sitePackages = pyodide.runPython("import sysconfig; sysconfig.get_paths()['purelib']")

    progress("Loading OpenCascade…", "ocp")
    const ocp = await ocpPromise
    for (const file of ocp.files) {
        writeFile(pyodide, `${sitePackages}/${file.name}`, file.data)
    }
    await timed("link OCP", () => linkPrecompiled(pyodide, `${sitePackages}/${ocp.libraryName}`, ocp.module))
    progress("Initializing OpenCascade…", "ocpInit")
    await timed("import OCP", () => pyodide.runPython("import OCP"))

    for (const entry of await sitePromise) {
        writeFile(pyodide, `${sitePackages}/${entry.name}`, entry.data)
    }
    for (const [path, bytes] of await inputFilesPromise) {
        writeFile(pyodide, MODEL_ROOT + path, bytes)
    }

    progress("Loading CadQuery…", "cadquery")
    await timed("import cadquery", () => pyodide.runPython(`
import lazy_imports
lazy_imports.install(
    deferred_installed=${JSON.stringify(DEFERRED_INSTALLED_MODULES)},
    deferred_packages=${JSON.stringify(DEFERRED_PACKAGES)},
    on_demand_modules=${JSON.stringify(Object.fromEntries(
        ON_DEMAND_URL ? ON_DEMAND_MODULES.map((m) => [m, ON_DEMAND_DOWNLOAD]) : []))},
)
lazy_imports.install_ocp_stubs()
import cadquery
`))
    const runner = pyodide.pyimport("cadquery_runner")
    if (FONTS_URL) {
        runner.install_font_hook(FONTS_DOWNLOAD)
    }
    logInfo(`[load] total: ${((performance.now() - start) / 1000).toFixed(2)}s`)
    runtimeReady = true
    return { pyodide, runner }
}

/** Download a bundle and write its files below a directory. */
async function loadBundle(pyodide, name, url, directory, label) {
    progress(`Loading ${label}…`)
    const files = await timed(`download and unpack ${label}`, () => prepareInHelper(name, url))
    for (const file of files) {
        writeFile(pyodide, `${directory}/${file.name}`, file.data)
    }
}

/**
 * Load what a model needs but isn't loaded yet: deferred Pyodide packages, the
 * on-demand site-packages bundle and fonts.
 */
async function loadMissing(pyodide, runner, missing) {
    const known = (name) => DEFERRED_PACKAGES.includes(name) ||
        (name === ON_DEMAND_DOWNLOAD && ON_DEMAND_URL) || (name === FONTS_DOWNLOAD && FONTS_URL)
    const unknown = missing.filter((name) => loadedOnDemand.has(name) || !known(name))
    if (unknown.length) {
        throw new Error(`Packages could not be loaded: ${unknown.join(", ")}`)
    }
    const packages = missing.filter((name) => DEFERRED_PACKAGES.includes(name))
    if (packages.length) {
        // All of them: they depend on each other, and loading them one by one
        // could take a retry each.
        const all = DEFERRED_PACKAGES.filter((name) => !loadedOnDemand.has(name))
        progress(`Loading ${all.join(", ")}…`)
        await timed(`load ${all.join(", ")}`, () =>
            pyodide.loadPackage(all, { messageCallback: logInfo, errorCallback: logError }))
        all.forEach((name) => loadedOnDemand.add(name))
    }
    if (missing.includes(ON_DEMAND_DOWNLOAD)) {
        const sitePackages = pyodide.runPython("import sysconfig; sysconfig.get_paths()['purelib']")
        await loadBundle(pyodide, ON_DEMAND_DOWNLOAD, ON_DEMAND_URL, sitePackages, ON_DEMAND_MODULES.join(", "))
        pyodide.pyimport("lazy_imports").mark_downloaded(ON_DEMAND_DOWNLOAD)
        loadedOnDemand.add(ON_DEMAND_DOWNLOAD)
    }
    if (missing.includes(FONTS_DOWNLOAD)) {
        await loadBundle(pyodide, FONTS_DOWNLOAD, FONTS_URL, runner.FONT_DIR, "fonts")
        runner.fonts_downloaded()
        loadedOnDemand.add(FONTS_DOWNLOAD)
    }
    pyodide.runPython("import importlib; importlib.invalidate_caches()")
}

async function getRuntime() {
    if (!runtimePromise) {
        runtimePromise = initRuntime()
    }
    try {
        return await runtimePromise
    } catch (e) {
        // Allow a retry on the next render, e.g. after a network error.
        runtimePromise = null
        throw e
    }
}

/** Non-indexed triangle positions from a binary STL. */
function stlPositions(bytes) {
    const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
    const count = view.getUint32(80, true)
    const positions = new Float32Array(count * 9)
    for (let i = 0; i < count; i++) {
        // Skip the 12 byte normal; 9 floats of vertex data follow.
        const offset = 84 + i * 50 + 12
        for (let j = 0; j < 9; j++) {
            positions[i * 9 + j] = view.getFloat32(offset + j * 4, true)
        }
    }
    return positions
}

function combineMeshes(parts) {
    let total = 0
    for (const part of parts) {
        total += part.positions.length
    }
    const positions = new Float32Array(total)
    const anyColor = parts.some((part) => part.color)
    const colors = anyColor ? new Float32Array(total) : null
    let offset = 0
    for (const part of parts) {
        positions.set(part.positions, offset)
        if (colors) {
            const [r, g, b] = part.color || DEFAULT_PART_COLOR
            for (let i = offset; i < offset + part.positions.length; i += 3) {
                colors[i] = r
                colors[i + 1] = g
                colors[i + 2] = b
            }
        }
        offset += part.positions.length
    }
    return { positions, colors }
}

function postError(e) {
    logError(e)
    let summary = formatErrorForMessage(e)
    if (e && e.type && typeof e.message === "string") {
        // Python exception: use the last traceback line as the summary.
        const lines = e.message.trim().split("\n")
        summary = lines[lines.length - 1]
    }
    self.postMessage({
        type: "error",
        error: summary,
        stack: String(e && e.stack ? e.stack : ""),
        log: getLog(),
    })
}

async function render({ input, normalParams, additionalParams, previewStyle }) {
    const { pyodide, runner } = await getRuntime()
    if (!INPUT_FILES.has(input)) {
        throw new Error(`Unknown input file: ${input}`)
    }
    const params = { ...normalParams, ...additionalParams }
    logInfo("Parameters:", params)
    progress("Rendering…", "render")

    const start = performance.now()
    let timings = {}
    let parts = null
    while (parts === null) {
        const pyParams = pyodide.toPy(params)
        let result
        try {
            result = runner.render(MODEL_ROOT + input, pyParams, TOLERANCE, ANGULAR_TOLERANCE)
        } finally {
            pyParams.destroy()
        }
        try {
            const converted = result.toJs({ dict_converter: Object.fromEntries })
            if (converted.missing) {
                // The model needs packages that are only loaded on demand.
                // loadMissing throws for anything already loaded, so this
                // retries at most once per download.
                await loadMissing(pyodide, runner, converted.missing)
                progress("Rendering…", "render")
                continue
            }
            timings = converted.timings
            parts = converted.parts.map((part) => ({
                name: part.name,
                color: part.color,
                positions: stlPositions(part.stl),
            }))
        } finally {
            result.destroy()
        }
    }
    logInfo("Parts:", parts.map((p) => `${p.name} (${p.positions.length / 9} triangles)`).join(", "))

    const pythonDone = performance.now()
    const mesh = combineMeshes(parts)
    const glb = await meshToGlb(mesh, previewStyle || "shaded")
    const glbDone = performance.now()
    const stl = offMeshToBinaryStl(mesh)
    const end = performance.now()
    const s = (ms) => `${(ms / 1000).toFixed(2)}s`
    logInfo(`[render] build ${s(timings.build * 1000)}, tessellate ${s(timings.tessellate * 1000)}, ` +
        `python total ${s(pythonDone - start)}, glb ${s(glbDone - pythonDone)}, stl ${s(end - glbDone)}, ` +
        `worker total ${s(end - start)}`)
    self.postMessage({ type: "ok", glb, stl, camera: null })
}

async function exportFile({ format }) {
    const { pyodide, runner } = await getRuntime()
    if (format !== "step") {
        throw new Error(`Unsupported export format: ${format}`)
    }
    const output = "/tmp/export.step"
    runner.export_step(output)
    const bytes = pyodide.FS.readFile(output)
    pyodide.FS.unlink(output)
    self.postMessage({ type: "export-ok", format, bytes })
}

self.addEventListener("message", (event) => {
    const msg = event && event.data
    if (!msg || typeof msg !== "object") {
        return
    }
    if (msg.type === "runtime-file" || msg.type === "runtime-file-failed") {
        // Answer to "prepare-runtime-file"; handled right away, not queued.
        const pending = helperResults.get(msg.task)
        if (pending) {
            helperResults.delete(msg.task)
            if (msg.type === "runtime-file") {
                pending.resolve(msg.result)
            } else {
                pending.reject(new Error(msg.error))
            }
        }
        return
    }
    // Serialize runs; the Python runtime is shared between them.
    runQueue = runQueue.then(async () => {
        if (msg.type === "render") {
            // Keep the runtime loading log until it is ready, so that load
            // failures show up in the render log.
            if (runtimeReady) {
                resetLog()
            }
            try {
                await render(msg)
            } catch (e) {
                postError(e)
            } finally {
                firstRenderDone = true
            }
        } else if (msg.type === "export") {
            try {
                await exportFile(msg)
            } catch (e) {
                logError(e)
                self.postMessage({
                    type: "export-error",
                    format: msg.format,
                    error: formatErrorForMessage(e),
                    log: getLog(),
                })
            }
        }
    })
})

// Start loading the runtime right away; the first render waits for it.
getRuntime().catch((e) => logError(e))
